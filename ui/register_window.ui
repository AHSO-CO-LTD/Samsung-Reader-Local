        <item><widget class="QPushButton" name="pushButtonRefreshStatus"><property name="minimumHeight"><number>36</number></property><property name="text"><string>Refresh Status</string></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
