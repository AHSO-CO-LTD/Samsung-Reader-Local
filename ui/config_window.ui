         <item><widget class="QPushButton" name="pushButtonConnect"><property name="minimumHeight"><number>34</number></property><property name="text"><string>Connect</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButtonDisconnect"><property name="minimumHeight"><number>34</number></property><property name="text"><string>Disconnect</string></property></widget></item>
