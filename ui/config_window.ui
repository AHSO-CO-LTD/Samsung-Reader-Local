         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <column><property name="text"><string>Name</string></property></column>
         <column><property name="text"><string>Role</string></property></column>
         <column><property name="text"><string>IP Address</string></property></column>
         <column><property name="text"><string>Data Port</string></property></column>
