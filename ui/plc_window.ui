  <property name="styleSheet">
   <string notr="true">/*
 Cùng convention với reconcile_window.ui/rework_window.ui/config_window.ui —
 kế thừa theme từ MainWindow qua cây cha-con (QGroupBox đã có sẵn style
 pill-badge chuẩn từ MainWindow, KHÔNG tự định nghĩa lại ở đây). Toàn bộ
 chữ trong dialog này dùng chung 1 màu trắng (#F3F7F5) cho đồng nhất,
 KHÔNG dùng nền sáng/màu chữ riêng cho label trạng thái nữa.
 */
QDialog {
    background-color: #1F403E;
}

QLabel {
    background-color: transparent;
    color: #F3F7F5;
}

QLabel#labelConnection, QLabel#labelReadResult, QLabel#labelWriteResult {
    font-weight: bold;
}

QSpinBox {
    max-width: 90px;
}</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayoutRoot">
   <item>
    <widget class="QGroupBox" name="groupBoxConnection">
     <property name="title">
      <string>Kết nối PLC</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutConnection">
      <item>
       <layout class="QHBoxLayout" name="horizontalLayoutConnType">
        <item>
         <widget class="QLabel" name="labelConnTypeCaption">
          <property name="text">
           <string>Loại kết nối:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="radioConnectionSerial">
